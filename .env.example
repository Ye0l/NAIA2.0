# docker compose settings for NAIA 2.0. Copy to .env and edit.
#   cp .env.example .env
# .env is gitignored; .env.example is not — keep secrets out of this file.

# Your host user, so files written into the mounts belong to you.
#   NAIA_UID=$(id -u)  NAIA_GID=$(id -g)
NAIA_UID=1000
NAIA_GID=1000

# Where the published port is reachable from.
# 127.0.0.1 = this machine only. See the warning in docker-compose.yml before
# changing it: inside the container the app treats every caller as local, so
# 0.0.0.0 hands out the stored NAI token and extension install to the network.
NAIA_BIND_ADDR=127.0.0.1
NAIA_HOST_PORT=7243

# One root for everything NAIA writes. Point it at an existing native install
# (Linux: ~/.local/share/NAIA) to reuse its token, tag archive and output.
NAIA_DATA_ROOT=./naia-data

# Individually relocatable directories. Leave commented to keep them inside
# NAIA_DATA_ROOT; set one to move just that directory to another disk.
#NAIA_OUTPUT_DIR=/mnt/big/naia/output
#NAIA_EXTENSIONS_DIR=./naia-data/extensions
#NAIA_CONFIG_DIR=./naia-data/config
#NAIA_WILDCARDS_DIR=./naia-data/wildcards
#NAIA_SAVE_DIR=./naia-data/save
#NAIA_TAGDATA_DIR=/mnt/big/naia/tags

# uvicorn log level: critical | error | warning | info | debug | trace
NAIA_LOG_LEVEL=warning
